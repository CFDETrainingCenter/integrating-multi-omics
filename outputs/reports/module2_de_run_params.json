  "methods_narrative": "Marker genes were identified on the Module 2 integrated HuBMAP lung object using scanpy.tl.rank_genes_groups (wilcoxon) grouped by `cell_class` with reference='rest' on log-normalized expression (scanpy 1.11.5). Gene symbols use `adata.var['hugo_symbol']` from the HuBMAP object (no GTEx read when `gtex_context=false`). Ribosomal protein genes (RPS/RPL/MRPS/MRPL, plus UBA52 and FAU which encode ribosomal proteins under non-RP names) were removed from reported marker tables so top-gene lists are not dominated by translation housekeeping. Genes with adjusted p<=0.05 and log-fold change>=0.25 were scored with over-representation enrichment (gseapy 1.3.1, mode=local_gmt) against local GMT libraries ['MSigDB_Hallmark_2020', 'Reactome_2022', 'GO_Biological_Process_2023'] using the object's measured gene symbols as background, again excluding ribosomal protein genes from enrichment inputs. Preranked GSEA (NES) uses Wilcoxon scores against the same GMTs when enabled. Cross-resource GTEx context is deferred to Module 4. Enrichment results are hypothesis-generating; this pipeline does not assert biological consistency.",
  "methods_table": [
    {
      "step": "Input",
      "parameters": "data/processed/integrated/module2_hubmap_lung_integrated.h5ad",
      "package_or_function": "Module 2 integrated AnnData"
    },
    {
      "step": "Comparison groups",
      "parameters": "groupby=cell_class",
      "package_or_function": "obs categorical"
    },
    {
      "step": "Optional fine DE",
      "parameters": "azimuth_focus=['AT2', 'AT1', 'EC general capillary', 'Alveolar fibroblasts', 'CD8 T cells']",
      "package_or_function": "scanpy.tl.rank_genes_groups"
    },
    {
      "step": "Marker DE",
      "parameters": "method=wilcoxon, n_genes=3000, min_cells_per_group=50, reference=rest",
      "package_or_function": "scanpy.tl.rank_genes_groups (Wilcoxon)"
    },
    {
      "step": "Expression matrix for DE",
      "parameters": "log-normalized `.X` (counts retained in `.layers['counts']`)",
      "package_or_function": "scanpy / anndata"
    },
    {
      "step": "Gene symbol resolution",
      "parameters": "use adata.var hugo_symbol from HuBMAP object (no GTEx read when gtex_context=false)",
      "package_or_function": "scripts.nb04_de.load.gene_symbol_series"
    },
    {
      "step": "Marker DE table filter",
      "parameters": "exclude_ribosomal_genes=True (RPS/RPL/MRPS/MRPL plus named exceptions UBA52, FAU removed from reported marker tables)",
      "package_or_function": "pandas filter after rank_genes_groups"
    },
    {
      "step": "Enrichment gene filter",
      "parameters": "padj<=0.05, logFC>=0.25, top=100, exclude_ribosomal_genes=True (config null follows de.exclude_ribosomal_genes=True)",
      "package_or_function": "pandas filters (drop RPS/RPL/MRPS/MRPL and UBA52/FAU)"
    },
    {
      "step": "Pathway enrichment (ORA)",
      "parameters": "mode=local_gmt, gene_sets=['MSigDB_Hallmark_2020', 'Reactome_2022', 'GO_Biological_Process_2023'], background=measured gene symbols, cutoff_padj=0.05",
      "package_or_function": "gseapy.enrich against local GMT (Enrichr online opt-in only)"
    },
    {
      "step": "Preranked GSEA",
      "parameters": "enabled=True, permutation_num=100",
      "package_or_function": "gseapy.prerank on Wilcoxon scores (NES)"
    },
    {
      "step": "Known marker validation",
      "parameters": "curated lung marker panel via HUGO when present, else Ensembl ID in var_names",
      "package_or_function": "dotplot"
    },
    {
